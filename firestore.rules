rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isPublished() { return resource.data.published == true; }
    function isApproved() { return resource.data.approved == true; }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    match /albums/{albumId} {
      allow read: if isPublished() || isAdmin();
      allow write: if isAdmin();
    }

    match /photos/{photoId} {
      allow read: if isPublished() || isAdmin();
      allow write: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.approved == false
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow read: if isApproved() || isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /comments/{commentId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.approved == false;
      allow read: if isApproved() || isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /profiles/{uid} {
      allow create, read, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /subscribers/{subscriberId} {
      allow create: if request.resource.data.email is string
        && request.resource.data.consent == 'on'
        && request.resource.data.active == true;
      allow read, update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /mailQueue/{messageId} {
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.type == 'new_booking'
        && request.resource.data.status == 'pending');
      allow read, update, delete: if isAdmin();
    }

    match /birthdayLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
